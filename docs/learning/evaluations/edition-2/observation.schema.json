{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-workbench.local/schemas/learning-edition-2-observation.schema.json",
  "title": "Edition 2 external observation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_id",
    "source_issue",
    "artifact",
    "overall_status",
    "lanes",
    "edition_changes",
    "limitations"
  ],
  "properties": {
    "$schema": {"const": "./observation.schema.json"},
    "schema_version": {"const": "learning-edition-2-observation/v1"},
    "record_id": {
      "type": "string",
      "pattern": "^edition-2-observation-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "source_issue": {"const": 387},
    "artifact": {"$ref": "#/$defs/artifact"},
    "overall_status": {
      "enum": ["awaiting_external_review", "in_progress", "complete"]
    },
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/realReaderLane"},
          {"$ref": "#/$defs/assistiveTechnologyLane"},
          {"$ref": "#/$defs/materialsDomainLane"},
          {"$ref": "#/$defs/securityLane"}
        ]
      }
    },
    "edition_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_1_errata", "edition_2_change_proposals"],
      "properties": {
        "edition_1_errata": {
          "type": "array",
          "items": {"$ref": "#/$defs/edition1Erratum"}
        },
        "edition_2_change_proposals": {
          "type": "array",
          "items": {"$ref": "#/$defs/edition2Proposal"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "commit",
        "html_path",
        "html_sha256",
        "pdf_path",
        "pdf_sha256"
      ],
      "properties": {
        "edition": {"const": 2},
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "html_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "html_sha256": {"$ref": "#/$defs/digest"},
        "pdf_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "pdf_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "laneStatus": {
      "enum": ["not_run", "awaiting_external_review", "in_progress", "completed"]
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pseudonym", "role"],
      "properties": {
        "pseudonym": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "pageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "location"],
      "properties": {
        "artifact": {"enum": ["html", "pdf"]},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "summary",
        "evidence",
        "disposition",
        "tracking"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^E2-F-[0-9]{3}$"},
        "severity": {"enum": ["blocking", "major", "minor", "note"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "disposition": {
          "enum": [
            "fixed_for_edition_2",
            "edition_2_change_proposed",
            "accepted_documented_limitation",
            "followup_issue_required",
            "no_change"
          ]
        },
        "tracking": {"type": ["string", "null"]}
      }
    },
    "readerTaskObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_pseudonym",
        "task_id",
        "started_at",
        "duration_seconds",
        "completed",
        "errors",
        "confusion_points",
        "backtracking_count",
        "consulted_pages",
        "confidence"
      ],
      "properties": {
        "participant_pseudonym": {"type": "string", "minLength": 1},
        "task_id": {
          "enum": ["reader-code-trace", "reader-decision-boundary"]
        },
        "started_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "completed": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "confusion_points": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "backtracking_count": {"type": "integer", "minimum": 0},
        "consulted_pages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pageReference"}
        },
        "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "realReaderLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "proxy", "participants", "task_observations", "findings"],
      "properties": {
        "kind": {"const": "real_reader"},
        "status": {"$ref": "#/$defs/laneStatus"},
        "proxy": {"const": false},
        "participants": {
          "type": "array",
          "items": {"$ref": "#/$defs/participant"}
        },
        "task_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/readerTaskObservation"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "assistiveTechnologyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "result", "observation", "evidence"],
      "properties": {
        "check_id": {
          "enum": [
            "reading-order",
            "math-pronunciation",
            "table-navigation",
            "keyboard",
            "zoom-200"
          ]
        },
        "result": {"enum": ["not_run", "pass", "fail", "blocked"]},
        "observation": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "browser_or_reader",
        "assistive_technology",
        "assistive_technology_version"
      ],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "browser_or_reader": {"type": "string", "minLength": 1},
        "assistive_technology": {"type": "string", "minLength": 1},
        "assistive_technology_version": {"type": "string", "minLength": 1}
      }
    },
    "assistiveTechnologyLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "proxy",
        "operator",
        "environment",
        "matrix",
        "findings"
      ],
      "properties": {
        "kind": {"const": "assistive_technology"},
        "status": {"$ref": "#/$defs/laneStatus"},
        "proxy": {"const": false},
        "operator": {
          "oneOf": [
            {"$ref": "#/$defs/participant"},
            {"type": "null"}
          ]
        },
        "environment": {
          "oneOf": [
            {"$ref": "#/$defs/environment"},
            {"type": "null"}
          ]
        },
        "matrix": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/assistiveTechnologyResult"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "domainReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "result", "observation"],
      "properties": {
        "topic": {
          "enum": [
            "units",
            "composition-basis",
            "process-vocabulary",
            "measurement-vocabulary"
          ]
        },
        "result": {"enum": ["not_run", "pass", "changes_requested"]},
        "observation": {"type": ["string", "null"]}
      }
    },
    "materialsDomainLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "proxy",
        "reviewer",
        "linked_issue",
        "issue_303_reflection",
        "review_results",
        "findings"
      ],
      "properties": {
        "kind": {"const": "materials_domain"},
        "status": {"$ref": "#/$defs/laneStatus"},
        "proxy": {"const": false},
        "reviewer": {
          "oneOf": [
            {"$ref": "#/$defs/participant"},
            {"type": "null"}
          ]
        },
        "linked_issue": {"const": 303},
        "issue_303_reflection": {"type": ["string", "null"]},
        "review_results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/domainReviewResult"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "securityReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "result", "observation"],
      "properties": {
        "topic": {
          "enum": ["threat", "control", "residual-risk", "recovery"]
        },
        "result": {"enum": ["not_run", "pass", "changes_requested"]},
        "observation": {"type": ["string", "null"]}
      }
    },
    "securityLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "proxy",
        "reviewer",
        "review_results",
        "findings"
      ],
      "properties": {
        "kind": {"const": "security"},
        "status": {"$ref": "#/$defs/laneStatus"},
        "proxy": {"const": false},
        "reviewer": {
          "oneOf": [
            {"$ref": "#/$defs/participant"},
            {"type": "null"}
          ]
        },
        "review_results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/securityReviewResult"}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "edition1Erratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "correction", "tracking"],
      "properties": {
        "id": {"type": "string", "pattern": "^E1-ERR-[0-9]{3}$"},
        "location": {"type": "string", "minLength": 1},
        "correction": {"type": "string", "minLength": 1},
        "tracking": {"type": ["string", "null"]}
      }
    },
    "edition2Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_finding", "proposal", "tracking"],
      "properties": {
        "id": {"type": "string", "pattern": "^E2-CHG-[0-9]{3}$"},
        "source_finding": {"type": "string", "pattern": "^E2-F-[0-9]{3}$"},
        "proposal": {"type": "string", "minLength": 1},
        "tracking": {"type": ["string", "null"]}
      }
    }
  }
}

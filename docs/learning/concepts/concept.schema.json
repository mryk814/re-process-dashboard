{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mryk814/re-process-dashboard/blob/learning/textbook/docs/learning/concepts/concept.schema.json",
  "title": "Evidence Decision Workbench learning concept inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository",
    "verified_commit",
    "categories",
    "chapters",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "const": "./concept.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "verified_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 50,
      "items": {
        "$ref": "#/$defs/concept"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identifierArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.qmd$"
        }
      }
    },
    "repoReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "docs",
            "contract",
            "domain",
            "application",
            "persistence",
            "api",
            "generated",
            "frontend",
            "test",
            "build"
          ]
        }
      }
    },
    "uiMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general",
        "internal",
        "ui"
      ],
      "properties": {
        "general": {
          "type": "string",
          "minLength": 1
        },
        "internal": {
          "type": "string",
          "minLength": 1
        },
        "ui": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term_ja",
        "term_en",
        "aliases",
        "category",
        "scope",
        "status",
        "status_note",
        "definition",
        "anti_definitions",
        "not_same_as",
        "prerequisites",
        "related",
        "math_connections",
        "repo_references",
        "common_misconceptions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "term_ja": {
          "type": "string",
          "minLength": 1
        },
        "term_en": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "enum": [
            "repo-wide",
            "subsystem",
            "pattern"
          ]
        },
        "status": {
          "enum": [
            "current",
            "future",
            "historical"
          ]
        },
        "status_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "anti_definitions": {
          "$ref": "#/$defs/stringArray"
        },
        "not_same_as": {
          "$ref": "#/$defs/identifierArray"
        },
        "prerequisites": {
          "$ref": "#/$defs/identifierArray"
        },
        "related": {
          "$ref": "#/$defs/identifierArray"
        },
        "math_connections": {
          "$ref": "#/$defs/stringArray"
        },
        "repo_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repoReference"
          }
        },
        "common_misconceptions": {
          "$ref": "#/$defs/stringArray"
        },
        "ui_mapping": {
          "$ref": "#/$defs/uiMapping"
        }
      }
    }
  }
}

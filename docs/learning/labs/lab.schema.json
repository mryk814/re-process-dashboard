{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-decision-workbench.local/learning/lab.schema.json",
  "title": "Material Decision Workbench learning lab manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "allowed_write_root",
    "protected_paths",
    "labs"
  ],
  "properties": {
    "$schema": {
      "const": "./lab.schema.json"
    },
    "schema_version": {
      "const": "learning-labs/v1"
    },
    "allowed_write_root": {
      "const": "artifacts/learning-labs"
    },
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lab"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lab_id",
        "document",
        "mode",
        "category",
        "title",
        "verified_commit",
        "expected_minutes",
        "requires",
        "fixtures",
        "commands",
        "writes",
        "must_not_write",
        "network",
        "secrets",
        "timeout_seconds",
        "expected_outcomes"
      ],
      "properties": {
        "lab_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "document": {
          "$ref": "#/$defs/repositoryPath"
        },
        "mode": {
          "enum": [
            "guided",
            "executable"
          ]
        },
        "category": {
          "enum": [
            "contract",
            "data",
            "frontend",
            "math",
            "persistence"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "verified_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "python"
            ]
          }
        },
        "fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setup",
            "run",
            "verify",
            "reset"
          ],
          "properties": {
            "setup": {
              "type": [
                "string",
                "null"
              ]
            },
            "run": {
              "type": [
                "string",
                "null"
              ]
            },
            "verify": {
              "type": [
                "string",
                "null"
              ]
            },
            "reset": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "must_not_write": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "network": {
          "const": "forbidden"
        },
        "secrets": {
          "const": "forbidden"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "expected_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

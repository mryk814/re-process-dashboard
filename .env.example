# Docker Compose専用のlocal開発値です。production credentialとして使いません。
WORKBENCH_POSTGRES_DB=workbench
WORKBENCH_POSTGRES_USER=workbench
WORKBENCH_POSTGRES_PASSWORD=local-development-only
WORKBENCH_POSTGRES_PORT=54321
WORKBENCH_DATABASE_URL=postgresql://workbench:local-development-only@127.0.0.1:54321/workbench
WORKBENCH_SHARED_DATABASE_URL=postgresql://workbench:local-development-only@127.0.0.1:54321/workbench

WORKBENCH_S3_ENDPOINT=http://127.0.0.1:59000
WORKBENCH_S3_BUCKET=workbench-artifacts
WORKBENCH_S3_REGION=us-east-1
WORKBENCH_S3_ACCESS_KEY=workbench-local
WORKBENCH_S3_SECRET_KEY=local-development-only
WORKBENCH_S3_PORT=59000
WORKBENCH_S3_CONSOLE_PORT=59001

# 現行applicationの既定値です。Compose fixtureへ自動切替しません。
WORKBENCH_PERSISTENCE_BACKEND=sqlite
WORKBENCH_ARTIFACT_BACKEND=local

# 個人用Model Packageの保存先です。
# 未指定時、Windowsでは %LOCALAPPDATA%\Material Decision Workbench\models を使います。
# WORKBENCH_MODEL_STORE_PATH=C:\Users\your-name\AppData\Local\Material Decision Workbench\models

# 検証済みdata-only個人Taskの保存先です。
# 未指定時、Windowsでは %LOCALAPPDATA%\Material Decision Workbench\tasks を使います。
# WORKBENCH_TASK_STORE_PATH=C:\Users\your-name\AppData\Local\Material Decision Workbench\tasks

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-throughput-result/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "observation_kind", "case", "profile", "conditions", "metrics", "run_receipt", "verification", "quality", "provenance"],
  "properties": {
    "schema_version": {"const": "agent-throughput-result/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "observation_kind": {"enum": ["context_only", "agent_run"]},
    "case": {
      "type": "object",
      "required": ["id", "version", "prompt_digest", "prompt_bytes", "prompt_lines", "fixture_digest", "success_criteria_digest", "catalog_digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "version": {"type": "integer", "minimum": 1},
        "prompt_digest": {"$ref": "#/$defs/sha256"},
        "prompt_bytes": {"type": "integer", "minimum": 1},
        "prompt_lines": {"type": "integer", "minimum": 1},
        "fixture_digest": {"$ref": "#/$defs/sha256"},
        "success_criteria_digest": {"$ref": "#/$defs/sha256"},
        "catalog_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["id", "expected_lane", "model_family", "reasoning_setting", "guidance_identity", "skill_inventory_identity", "verification_policy_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "expected_lane": {"enum": ["fast", "deep"]},
        "model_family": {"type": ["string", "null"]},
        "reasoning_setting": {"type": ["string", "null"]},
        "guidance_identity": {
          "type": "object",
          "required": ["source_ref", "materialization", "root_instruction_bytes", "root_instruction_lines", "root_instruction_digest"],
          "properties": {
            "source_ref": {"$ref": "#/$defs/commit"},
            "materialization": {"enum": ["snapshot_only_not_executed", "repository_context_observed_not_task_executed", "agent_run"]},
            "root_instruction_bytes": {"type": "integer", "minimum": 1},
            "root_instruction_lines": {"type": "integer", "minimum": 1},
            "root_instruction_digest": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "skill_inventory_identity": {
          "type": "object",
          "required": ["source_ref", "discovery_root", "tree_digest", "typed_inventory_digest", "visible_skill_count", "visible_skill_names"],
          "properties": {
            "source_ref": {"$ref": "#/$defs/commit"},
            "discovery_root": {"const": ".agents/skills"},
            "tree_digest": {"$ref": "#/$defs/sha256"},
            "typed_inventory_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
            "visible_skill_count": {"type": "integer", "minimum": 0},
            "visible_skill_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "verification_policy_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "object",
      "required": ["repository_commit", "same_success_criteria", "fresh_session", "fresh_workspace", "session_identity", "workspace_identity", "environment_identity_digest"],
      "properties": {
        "repository_commit": {"$ref": "#/$defs/commit"},
        "same_success_criteria": {"const": true},
        "fresh_session": {"type": ["boolean", "null"]},
        "fresh_workspace": {"type": ["boolean", "null"]},
        "session_identity": {"type": ["string", "null"]},
        "workspace_identity": {"type": ["string", "null"]},
        "environment_identity_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["first_edit_elapsed_ms", "first_edit_read_file_count", "first_edit_tool_call_count", "total_tool_call_count", "duplicate_command_count", "local_verification_duration_ms", "total_elapsed_ms", "edit_to_pass_iteration_count", "changed_file_count", "changed_line_count", "input_tokens", "output_tokens", "command_observations", "credit_proxy"],
      "properties": {
        "first_edit_elapsed_ms": {"$ref": "#/$defs/nullable_number"},
        "first_edit_read_file_count": {"$ref": "#/$defs/nullable_integer"},
        "first_edit_tool_call_count": {"$ref": "#/$defs/nullable_integer"},
        "total_tool_call_count": {"$ref": "#/$defs/nullable_integer"},
        "duplicate_command_count": {"$ref": "#/$defs/nullable_integer"},
        "local_verification_duration_ms": {"$ref": "#/$defs/nullable_number"},
        "total_elapsed_ms": {"$ref": "#/$defs/nullable_number"},
        "edit_to_pass_iteration_count": {"$ref": "#/$defs/nullable_integer"},
        "changed_file_count": {"$ref": "#/$defs/nullable_integer"},
        "changed_line_count": {"$ref": "#/$defs/nullable_integer"},
        "input_tokens": {"$ref": "#/$defs/nullable_integer"},
        "output_tokens": {"$ref": "#/$defs/nullable_integer"},
        "command_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command_digest", "count", "duration_ms"],
            "properties": {
              "command_digest": {"$ref": "#/$defs/sha256"},
              "count": {"type": "integer", "minimum": 1},
              "duration_ms": {"$ref": "#/$defs/nullable_number"}
            },
            "additionalProperties": false
          }
        },
        "credit_proxy": {
          "type": "object",
          "required": ["kind", "value", "unit", "not_provider_token", "provenance"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "value": {"$ref": "#/$defs/nullable_number"},
            "unit": {"type": "string", "minLength": 1},
            "not_provider_token": {"const": true},
            "provenance": {"$ref": "#/$defs/provenance"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "run_receipt": {
      "type": "object",
      "required": ["status", "locator", "digest"],
      "properties": {
        "status": {"enum": ["verified", "not_available"]},
        "locator": {"type": ["string", "null"]},
        "digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "duration_ms", "receipts", "note"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_run"]},
        "duration_ms": {"$ref": "#/$defs/nullable_number"},
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate_id", "receipt_digest", "receipt_locator", "environment_identity_digest", "duration_ms"],
            "properties": {
              "gate_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "receipt_digest": {"$ref": "#/$defs/sha256"},
              "receipt_locator": {"type": "string", "minLength": 1},
              "environment_identity_digest": {"$ref": "#/$defs/sha256"},
              "duration_ms": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["status", "success_criteria_met", "human_review", "findings", "note"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_evaluated"]},
        "success_criteria_met": {"type": ["boolean", "null"]},
        "human_review": {
          "type": "object",
          "required": ["status", "reviewer_kind", "completed_at", "provenance"],
          "properties": {
            "status": {"enum": ["completed", "not_run"]},
            "reviewer_kind": {"enum": ["independent_human", null]},
            "completed_at": {"type": ["string", "null"]},
            "provenance": {"anyOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]}
          },
          "additionalProperties": false
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
  },
  "allOf": [
    {
      "if": {"properties": {"observation_kind": {"const": "agent_run"}}, "required": ["observation_kind"]},
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "model_family": {"type": "string", "minLength": 1},
              "reasoning_setting": {"type": "string", "minLength": 1},
              "guidance_identity": {"properties": {"materialization": {"const": "agent_run"}}}
            }
          },
          "conditions": {
            "properties": {
              "fresh_session": {"const": true},
              "fresh_workspace": {"const": true},
              "session_identity": {"type": "string", "minLength": 1},
              "workspace_identity": {"type": "string", "minLength": 1}
            }
          },
          "run_receipt": {
            "properties": {
              "status": {"const": "verified"},
              "locator": {"type": "string", "minLength": 1},
              "digest": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verification": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}}, "required": ["verification"]},
      "then": {
        "properties": {
          "conditions": {"properties": {"environment_identity_digest": {"$ref": "#/$defs/sha256"}}},
          "verification": {
            "properties": {
              "duration_ms": {"type": "number", "minimum": 0},
              "receipts": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"quality": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}}, "required": ["quality"]},
      "then": {
        "properties": {
          "quality": {
            "properties": {
              "success_criteria_met": {"const": true},
              "human_review": {
                "properties": {
                  "status": {"const": "completed"},
                  "reviewer_kind": {"const": "independent_human"},
                  "completed_at": {"type": "string", "format": "date-time"},
                  "provenance": {"$ref": "#/$defs/provenance"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullable_number": {"type": ["number", "null"], "minimum": 0},
    "nullable_integer": {"type": ["integer", "null"], "minimum": 0},
    "provenance": {
      "type": "object",
      "required": ["kind", "locator", "digest"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}},
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["severity", "summary"],
      "properties": {"severity": {"enum": ["low", "medium", "high", "critical"]}, "summary": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-throughput-case/v1",
  "type": "object",
  "required": ["id", "version", "category", "expected_lane", "prompt", "fixture", "success_criteria", "required_focused_evidence", "forbidden_changes", "review_checklist", "resource_ceiling"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "category": {"type": "string"},
    "expected_lane": {"enum": ["fast", "deep"]},
    "prompt": {"type": "string", "minLength": 1},
    "fixture": {"type": "object", "required": ["kind", "setup_command"]},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_focused_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "review_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "resource_ceiling": {"type": "object", "required": ["elapsed_minutes", "tool_calls"]}
  },
  "additionalProperties": false
}

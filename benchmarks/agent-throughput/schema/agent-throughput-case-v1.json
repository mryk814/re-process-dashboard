{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-throughput-case/v1",
  "type": "object",
  "required": ["id", "version", "category", "expected_lane", "prompt", "allowed_starting_context", "fixture", "success_criteria", "required_focused_evidence", "forbidden_changes", "review_checklist", "resource_ceiling"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "category": {"enum": ["pure_docs_typo", "backend_one_authority_bug", "web_local_interaction", "test_only_regression", "api_field_addition", "model_runtime_scientific_contract"]},
    "expected_lane": {"enum": ["fast", "deep"]},
    "prompt": {"type": "string", "minLength": 1},
    "allowed_starting_context": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fixture": {
      "type": "object",
      "required": ["kind", "patch_path", "patch_digest", "materialized_diff_digest", "changed_paths", "setup_command", "reset_command"],
      "properties": {
        "kind": {"const": "git_apply_patch"},
        "patch_path": {"type": "string", "pattern": "^benchmarks/agent-throughput/fixtures/[a-z0-9-]+\\.patch$"},
        "patch_digest": {"$ref": "#/$defs/sha256"},
        "materialized_diff_digest": {"$ref": "#/$defs/sha256"},
        "changed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "setup_command": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/non_placeholder_string"}},
        "reset_command": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/non_placeholder_string"}}
      },
      "additionalProperties": false
    },
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_focused_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "command_argv"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "command_argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_placeholder_string"}}
        },
        "additionalProperties": false
      }
    },
    "forbidden_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_checklist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resource_ceiling": {
      "type": "object",
      "required": ["elapsed_minutes", "tool_calls", "input_tokens", "output_tokens"],
      "properties": {
        "elapsed_minutes": {"type": "integer", "minimum": 1},
        "tool_calls": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_placeholder_string": {"type": "string", "minLength": 1, "pattern": "^(?!.*<[^>]+>).+$"}
  },
  "additionalProperties": false
}

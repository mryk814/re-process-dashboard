{
  "name": "@material-workbench/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node build.mjs",
    "typecheck": "node scripts/check-import-boundaries.mjs && tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "api:types": "openapi-typescript src/generated/openapi.json -o src/generated/api-types.ts --alphabetize",
    "api:check": "openapi-typescript src/generated/openapi.json -o src/generated/api-types.ts --alphabetize --check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-fetch": "^0.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "openapi-typescript": "^7.9.1"
  }
}

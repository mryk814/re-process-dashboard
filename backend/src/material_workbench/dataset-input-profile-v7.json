        {"path":"process.ls_mpm","role":"annealing","column":"LS[mpm]","kind":"entity_scalar","source_unit":"mpm","canonical_unit":"mpm"},
        {"path":"heat_pattern","role":"anneal_history","kind":"ordered_heat_series","normalizer_id":"stage_local_clock/v1","series_columns":{"parent":"焼鈍履歴_key**","order":"チャンネル","time":"到達時間[秒]","value":"温度[℃]","time_source_unit":"秒","time_canonical_unit":"s","value_source_unit":"℃","value_canonical_unit":"°C"},"parent_entity_type":"annealing"}

        {"path":"composition.Cu","role":"melt","column":"Cu%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Ni","role":"melt","column":"Ni%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Cr","role":"melt","column":"Cr%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Mo","role":"melt","column":"Mo%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Ti","role":"melt","column":"Ti%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.B","role":"melt","column":"B%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.O","role":"melt","column":"O%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.N","role":"melt","column":"N%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"process.soaking_temperature_c","role":"hot_rolling","column":"均熱温度[℃]","kind":"entity_scalar","source_unit":"℃","canonical_unit":"°C"},
        {"path":"process.finish_temperature_c","role":"hot_rolling","column":"仕上げ温度[℃]","kind":"entity_scalar","source_unit":"℃","canonical_unit":"°C"},
        {"path":"process.entry_thickness_mm","role":"hot_rolling","column":"入側板厚[mm]","kind":"entity_scalar","source_unit":"mm","canonical_unit":"mm"},
        {"path":"process.exit_thickness_mm","role":"hot_rolling","column":"出側板厚[mm]","kind":"entity_scalar","source_unit":"mm","canonical_unit":"mm"},
        {"path":"process.hold_temperature_c","role":"hot_rolling","column":"保持温度[℃]","kind":"entity_scalar","source_unit":"℃","canonical_unit":"°C"},
        {"path":"process.hold_time_min","role":"hot_rolling","column":"保持時間[min]","kind":"entity_scalar","source_unit":"min","canonical_unit":"min"}

{
  "schema_version": "dataset-input-profile/v2",
  "id": "process-dashboard-realistic-v3",
  "source_markers": [
    {"sheet": "焼鈍条件-3CGL", "column": "炉区分", "values": ["3-CGL"]},
    {"sheet": "焼鈍履歴", "column": "工程", "values": ["H1", "保持炉"]}
  ],
  "extends": "dataset-input-profile-v1.json",
  "shared": {
    "sheets": {
      "melt": "溶製成績書",
      "hot_rolling": "熱延条件",
      "cold_rolling": "冷延条件",
      "annealing": "焼鈍条件-3CGL",
      "hot_tensile": "熱延引張実績",
      "hot_microstructure": "熱延組織",
      "anneal_tensile": "焼鈍引張実績",
      "anneal_hole": "焼鈍穴拡げ実績",
      "anneal_microstructure": "焼鈍板組織",
      "anneal_features": "焼鈍特徴量",
      "anneal_history": "焼鈍履歴",
      "relation": "relationEx"
    },
    "entities": [
      {"type":"melt","role":"melt","key":"溶製成績書_key**"},
      {"type":"hot_rolling","role":"hot_rolling","key":"熱延_key**"},
      {"type":"cold_rolling","role":"cold_rolling","key":"冷延条件_key**"},
      {"type":"annealing","role":"annealing","key":"焼鈍条件-3CGL_key**"},
      {"type":"hot_tensile","role":"hot_tensile","key":"熱延引張実績_key**"},
      {"type":"hot_microstructure","role":"hot_microstructure","key":"熱延組織_key**"},
      {"type":"anneal_tensile","role":"anneal_tensile","key":"焼鈍引張実績_key**"},
      {"type":"anneal_hole","role":"anneal_hole","key":"焼鈍穴拡げ実績_key**"},
      {"type":"anneal_microstructure","role":"anneal_microstructure","key":"焼鈍板組織_key**"}
    ],
    "relation": {
      "role":"relation",
      "joins":[
        {"path":"melt","entity_type":"melt","column":"溶製成績書_key**","cardinality":"zero_or_one","stage":0,"parent_entity_types":[]},
        {"path":"hot_rolling","entity_type":"hot_rolling","column":"熱延条件_key**","cardinality":"zero_or_one","stage":1,"parent_entity_types":["melt"]},
        {"path":"cold_rolling","entity_type":"cold_rolling","column":"冷延条件_key**","cardinality":"zero_or_one","stage":3,"parent_entity_types":["hot_rolling"]},
        {"path":"annealing","entity_type":"annealing","column":"焼鈍履歴_key**","cardinality":"zero_or_one","stage":4,"parent_entity_types":["cold_rolling","hot_rolling"],"edge_parent_entity_types":["cold_rolling"]},
        {"path":"hot_tensile","entity_type":"hot_tensile","column":"熱延引張実績_key**","cardinality":"zero_or_one","stage":2,"parent_entity_types":["hot_rolling"]},
        {"path":"hot_microstructure","entity_type":"hot_microstructure","column":"熱延組織_key**","cardinality":"zero_or_one","stage":2,"parent_entity_types":["hot_rolling"]},
        {"path":"anneal_tensile","entity_type":"anneal_tensile","column":"焼鈍引張実績_key**","cardinality":"zero_or_one","stage":5,"parent_entity_types":["annealing"]},
        {"path":"anneal_hole","entity_type":"anneal_hole","column":"焼鈍穴拡げ実績_key**","cardinality":"zero_or_one","stage":5,"parent_entity_types":["annealing"]},
        {"path":"anneal_microstructure","entity_type":"anneal_microstructure","column":"焼鈍板組織_key**","cardinality":"zero_or_one","stage":5,"parent_entity_types":["annealing"]}
      ]
    },
    "eligibility": [
      {"role":"annealing","column":"学習利用区分","policy":"learning_flag/v1","accepted_values":["学習"]},
      {"role":"anneal_features","column":"特徴量化判定","policy":"anneal_feature_status/v1","accepted_values":["特徴量化可"]},
      {"role":"hot_tensile","column":"判定","policy":"valid_observation/v1","accepted_values":["有効"]},
      {"role":"anneal_tensile","column":"判定","policy":"valid_observation/v1","accepted_values":["有効"]},
      {"role":"anneal_hole","column":"判定","policy":"valid_observation/v1","accepted_values":["有効"]}
    ],
    "policy_defaults": {"hot_rolling.learning_flag/v1": true},
    "technical": [
      {"role":"melt","name":"family","column":"鋼種"},
      {"role":"annealing","name":"project","column":"プロジェクト名"},
      {"role":"hot_rolling","name":"equipment","column":"設備"},
      {"role":"anneal_history","name":"parent_key","column":"焼鈍履歴_key**"},
      {"role":"anneal_history","name":"order","column":"チャンネル"},
      {"role":"anneal_history","name":"time_s","column":"到達時刻[s]"},
      {"role":"anneal_history","name":"temperature_c","column":"温度[℃]"},
      {"role":"anneal_history","name":"stage_name","column":"工程"},
      {"role":"anneal_features","name":"parent_key","column":"焼鈍_key**"},
      {"role":"anneal_features","name":"max_temperature_c","column":"最高実績温度[℃]"},
      {"role":"anneal_features","name":"hold_time_s","column":"高温保持時間[s]"},
      {"role":"anneal_features","name":"input_points","column":"入力点数"},
      {"role":"anneal_features","name":"reheat","column":"再加熱工程あり"},
      {"role":"anneal_features","name":"alloying","column":"合金化工程あり"},
      {"role":"anneal_features","name":"feature_status","column":"特徴量化判定"},
      {"role":"anneal_features","name":"standard_route","column":"標準ルート"},
      {"role":"anneal_features","name":"process_signature","column":"標準工程シグネチャ"},
      {"role":"anneal_features","name":"unmapped_stage_count","column":"未確定工程名数"}
    ],
    "optional_roles": ["quality"],
    "optional_technical_fields": ["quality.category","anneal_history.set_temperature_c","anneal_history.stage_category","anneal_history.mapping_status"],
    "metadata_columns": ["ロット","プロジェクト名","登録者","登録日","試験者","試験日","入力者"],
    "physical_ranges": {
      "hot-rolled-properties-v1": {"TS":[100,2500],"YS":[50,2200],"EL":[0,100],"uniform_elongation":[0,100]}
    }
  },
  "tasks": {
    "hot-rolled-properties-v1": {
      "mappings": [
        {"path":"composition.C","role":"melt","column":"C%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Si","role":"melt","column":"Si%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Mn","role":"melt","column":"Mn%","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},

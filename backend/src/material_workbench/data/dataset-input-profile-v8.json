{
  "schema_version": "dataset-input-profile/v2",
  "id": "process-dashboard-two-equipment-v8",
  "extends": "dataset-input-profile-v7.json",
  "source_markers": [
    {"sheet":"測定点マスタ","column":"設備コード","values":["3CGL"]},
    {"sheet":"測定点マスタ","column":"工程","values":["PHF","RTS","3RCS","OAS出口","水冷"]},
    {"sheet":"熱延条件","column":"熱延条件_key**","values":["HR-00001"]}
  ],
  "shared": {
    "entities": [
      {"type":"melt","role":"melt","key":"溶製成績書_key**"},
      {"type":"hot_rolling","role":"hot_rolling","key":"熱延条件_key**"},
      {"type":"cold_rolling","role":"cold_rolling","key":"冷延条件_key**"},
      {"type":"annealing","role":"annealing","key":"焼鈍条件-3CGL_key**"},
      {"type":"hot_tensile","role":"hot_tensile","key":"熱延引張実績_key**"},
      {"type":"hot_microstructure","role":"hot_microstructure","key":"熱延組織_key**"},
      {"type":"anneal_tensile","role":"anneal_tensile","key":"焼鈍引張実績_key**"},
      {"type":"anneal_hole","role":"anneal_hole","key":"焼鈍穴拡げ実績_key**"},
      {"type":"anneal_microstructure","role":"anneal_microstructure","key":"焼鈍板組織_key**"}
    ],
    "technical": [
      {"role":"anneal_history","name":"parent_key","column":"焼鈍履歴_key**"},
      {"role":"anneal_history","name":"order","column":"チャンネル"},
      {"role":"anneal_history","name":"time_s","column":"total時間[秒]"},
      {"role":"anneal_history","name":"temperature_c","column":"温度[℃]"},
      {"role":"anneal_history","name":"stage_name","column":"工程"}
    ],
    "optional_technical_fields": [
      "melt.family","annealing.project","quality.category","hot_rolling.equipment",
      "anneal_features.parent_key","anneal_features.max_temperature_c",
      "anneal_features.hold_time_s","anneal_features.input_points",
      "anneal_features.reheat","anneal_features.alloying",
      "anneal_features.feature_status","anneal_features.standard_route",
      "anneal_features.process_signature","anneal_features.unmapped_stage_count",
      "anneal_history.set_temperature_c","anneal_history.stage_category",
      "anneal_history.mapping_status"
    ]
  },
  "tasks": {
    "hot-rolled-properties-v1": {
      "observations": [{
        "role":"hot_tensile",
        "id_column":"熱延引張実績_key**",
        "parent_entity_type":"hot_rolling",
        "metadata_columns":{"date":"試験日"},
        "optional_metadata_keys":["date"],
        "targets":[{"key":"TS","column":"引張強さ[MPa]","unit":"MPa"}],
        "auxiliary":[
          {"key":"YS","columns":["降伏点[MPa]","0.2耐力点[Mpa]"],"unit":"MPa"},
          {"key":"EL","column":"一様伸び[%]","unit":"%"},
          {"key":"uniform_elongation","column":"均一伸び[%]","unit":"%"}
        ],
        "optional_auxiliary_keys":["YS","EL","uniform_elongation"]
      }]
    },
    "annealed-properties-v1": {
      "mappings": [
        {"path":"composition.C","role":"melt","column":"C[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Si","role":"melt","column":"Si[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Mn","role":"melt","column":"Mn[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.P","role":"melt","column":"P[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.S","role":"melt","column":"S[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Al","role":"melt","column":"Al[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Cu","role":"melt","column":"Cu[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Ni","role":"melt","column":"Ni[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Cr","role":"melt","column":"Cr[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Mo","role":"melt","column":"Mo[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.Ti","role":"melt","column":"Ti[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.B","role":"melt","column":"B[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.O","role":"melt","column":"O[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"composition.N","role":"melt","column":"N[%]","kind":"entity_scalar","source_unit":"%","canonical_unit":"%"},
        {"path":"process.ls_mpm","role":"annealing","column":"LS[mpm]","kind":"entity_scalar","source_unit":"mpm","canonical_unit":"mpm"},
        {
          "path":"heat_pattern",
          "role":"anneal_history",
          "kind":"ordered_heat_series",
          "normalizer_id":"stage_local_clock/v1",
          "series_columns":{"parent":"焼鈍履歴_key**","order":"チャンネル","time":"total時間[秒]","value":"温度[℃]","time_source_unit":"秒","time_canonical_unit":"s","value_source_unit":"℃","value_canonical_unit":"°C"},
          "parent_entity_type":"annealing",
          "measurement_point_fallback":{
            "source_role":"annealing",
            "master_role":"measurement_points",
            "line_speed_path":"process.ls_mpm",
            "equipment_column":"設備コード",
            "equipment_value":"3CGL",
            "order_column":"点順",
            "stage_column":"工程",
            "position_column":"入口からの距離[m]",
            "position_unit":"m",
            "temperature_column_template":"{stage}[℃]",
            "temperature_source_unit":"℃",
            "temperature_canonical_unit":"°C"
          }
        }
      ],
      "observations": [
        {
          "role":"anneal_tensile",
          "id_column":"焼鈍引張実績_key**",
          "parent_entity_type":"annealing",
          "metadata_columns":{"date":"試験日"},
          "optional_metadata_keys":["date"],
          "targets":[
            {"key":"TS","column":"引張強さ[MPa]","unit":"MPa"},
            {"key":"YS","columns":["降伏点[MPa]","0.2耐力点[MPa]"],"unit":"MPa"},
            {"key":"EL","column":"伸び_突き合せ[%]","unit":"%"}
          ],
          "auxiliary":[
            {"key":"uniform_elongation","column":"一様伸び[%]","unit":"%"},
            {"key":"n_value","column":"n値[-]","unit":"1"}
          ],
          "optional_auxiliary_keys":["uniform_elongation","n_value"]
        },
        {
          "role":"anneal_hole",
          "id_column":"焼鈍穴拡げ実績_key**",
          "parent_entity_type":"annealing",
          "metadata_columns":{"date":"試験日"},
          "optional_metadata_keys":["date"],
          "targets":[{"key":"lambda","column":"穴拡げ率[%]","unit":"%"}],
          "auxiliary":[]
        }
      ]
    }
  }
}

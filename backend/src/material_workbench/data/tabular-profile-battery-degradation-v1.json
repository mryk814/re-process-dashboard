{
  "schema_version": "tabular-dataset-profile/v1",
  "profile_id": "calce-cs2-battery-capacity-v1",
  "name": "CALCE CS2実測：電池容量劣化",
  "task_id": "battery-degradation-v1",
  "package_id": "battery-degradation-lightgbm-calce-v1",
  "id_column": "cell_id",
  "group_column": "cell_id",
  "curve_axis_path": "process.cycle_index",
  "model_family": "lightgbm_monotone",
  "num_boost_round": 200,
  "monotone_decreasing_paths": ["process.cycle_index"],
  "inputs": [
    {
      "path": "process.discharge_rate_c",
      "column": "discharge_rate_c",
      "kind": "number",
      "unit": "C",
      "transform": "linear"
    },
    {
      "path": "process.cycle_index",
      "column": "cycle_index",
      "kind": "number",
      "unit": "cycle",
      "transform": "linear"
    }
  ],
  "outputs": [
    {
      "key": "capacity_percent",
      "column": "capacity_percent",
      "unit": "%",
      "lower_bound": 0,
      "upper_bound": 110
    }
  ],
  "quality_rules": []
}
